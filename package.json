{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Geetam's portfolio: a one-page git story. No framework and no build step; content lives in content/.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check-content.mjs && node scripts/sync-head.mjs --check",
    "sync": "node scripts/sync-head.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
